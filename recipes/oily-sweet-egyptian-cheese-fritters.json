{
  "title": "Oily Sweet Egyptian Cheese Fritters",
  "description": "Crispy, sweet fritters packed with parmesan and a drizzle of honey, perfect for a quick kosher-friendly dinner.",
  "cuisine": "Egyptian",
  "diet": [
    "kosher"
  ],
  "meal": "dinner",
  "ingredients": [
    {
      "name": "all-purpose flour",
      "amount": "120 g"
    },
    {
      "name": "granulated sugar",
      "amount": "40 g"
    },
    {
      "name": "grated parmesan cheese",
      "amount": "100 g"
    },
    {
      "name": "large eggs",
      "amount": "2"
    },
    {
      "name": "whole milk",
      "amount": "200 ml"
    },
    {
      "name": "baking powder",
      "amount": "1 tsp"
    },
    {
      "name": "salt",
      "amount": "1/4 tsp"
    },
    {
      "name": "ground cinnamon",
      "amount": "1 tsp"
    },
    {
      "name": "vegetable oil",
      "amount": "100 ml"
    },
    {
      "name": "honey",
      "amount": "20 g"
    }
  ],
  "instructions": [
    "Whisk flour, sugar, baking powder, salt, and cinnamon in a bowl.",
    "Add eggs and milk, then stir until a smooth batter forms.",
    "Fold in grated parmesan until evenly distributed.",
    "Heat oil in a deep pot to 170°C.",
    "Drop spoonfuls of batter into the hot oil, frying until golden brown on both sides.",
    "Remove fritters with a slotted spoon and drain on paper towels.",
    "Serve hot, drizzled with honey for a sweet finish.",
    "Enjoy immediately for the best crunch."
  ],
