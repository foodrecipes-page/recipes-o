  "instructions": [
    "Heat oil in a pan over medium heat.",
    "Add mustard seeds and cumin seeds and let them splutter.",
    "Add curry leaves and green chilies and saute for 1 minute.",
    "Add mitsuba and saute until it wilts.",
    "Add rice noodles and toss to combine with the mitsuba mixture.",
    "Add water and salt and stir to combine.",
    "Reduce heat to low and simmer for 5 minutes.",
    "Stir in lime juice and serve hot."
  ],
