    },
    {
      "name": "salt",
      "amount": "1/2 tsp"
    },
    {
      "name": "pepper",
      "amount": "1/4 tsp"
    },
    {
      "name": "olive oil",
      "amount": "2 tbsp"
    }
  ],
  "instructions": [
    "Preheat the oven to 400 degrees Fahrenheit",
    "In a small bowl, whisk together olive oil, garlic powder, salt, and pepper",
    "Brush the mixture onto the flatbread, leaving a 1 inch border around the edges",
    "Arrange the pickle slices on top of the flatbread, leaving some space between each slice",
    "Sprinkle the feta cheese and kalamata olives over the pickles",
    "Top with chopped parsley",
    "Place the flatbread on a baking sheet and roast in the oven for 15 minutes",
    "Remove from the oven and let cool for a few minutes before slicing and serving"
  ],
