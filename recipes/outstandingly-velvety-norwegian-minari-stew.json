  "ingredients": [
    {
      "name": "minari",
      "amount": "2 cups",
      "notes": "chopped"
    },
    {
      "name": "infuse oil",
      "amount": "1/4 cup"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "ginger",
      "amount": "1 inch",
      "notes": "grated"
    },
    {
      "name": "vegetable broth",
      "amount": "4 cups"
    },
    {
      "name": "coconut milk",
      "amount": "1 cup"
    },
    {
      "name": "norwegian chili flakes",
      "amount": "1 teaspoon"
    }
  ],
  "instructions": [
    "Heat the infuse oil in a large pot over medium heat.",
    "Add the chopped onion and cook until it is translucent.",
    "Add the minced garlic and grated ginger and cook for another minute.",
    "Add the chopped minari and cook until it is slightly tender.",
    "Add the vegetable broth, norwegian chili flakes, and bring to a boil.",
    "Reduce the heat to low and simmer for 20 minutes.",
    "Stir in the coconut milk and continue to simmer for another 10 minutes.",
    "Season with salt and pepper to taste.",
    "Serve hot and enjoy."
  ],
