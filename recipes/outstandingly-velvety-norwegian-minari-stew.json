{
  "title": "Outstandingly Velvety Norwegian Minari Stew",
  "description": "A spicy and comforting Norwegian dish featuring minari, infused with oil and suitable for a jain-friendly diet, this stew is perfect for a cold winter's night.",
  "cuisine": "Norwegian",
  "diet": [
    "jain",
    "vegetarian"
