      "name": "beef sirloin",
      "amount": "1 pound",
      "notes": "cut into thin strips"
    },
    {
      "name": "peanut oil",
      "amount": "1/4 cup"
    },
    {
      "name": "coconut milk",
      "amount": "1/2 cup"
    },
    {
      "name": "peanut butter",
      "amount": "2 tablespoons"
    },
    {
      "name": "lime juice",
      "amount": "2 tablespoons"
    },
    {
      "name": "soy sauce",
      "amount": "1 tablespoon"
    },
    {
      "name": "brown sugar",
      "amount": "1 tablespoon"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "ginger",
      "amount": "1 inch",
      "notes": "grated"
    },
    {
      "name": "cayenne pepper",
      "amount": "1/2 teaspoon"
    }
  ],
  "instructions": [
    "Preheat the hot stone plate to 400 degrees Fahrenheit.",
    "In a large bowl, whisk together coconut milk, peanut butter, lime juice, soy sauce, brown sugar, garlic, ginger, and cayenne pepper.",
    "Add the beef strips to the bowl and marinate for at least 30 minutes.",
    "Thread the marinated beef strips onto skewers.",
    "Brush the hot stone plate with peanut oil.",
    "Grill the beef skewers on the hot stone plate for 5-7 minutes per side.",
    "Serve the beef satay hot with spicy peanut sauce for dipping.",
    "Garnish with sliced onions and cilantro if desired."
  ],
