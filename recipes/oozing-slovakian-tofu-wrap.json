      "notes": "washed and blanched 2 min"
    },
    {
      "name": "extra firm tofu",
      "amount": "200g",
      "notes": "pressed and cubed"
    },
    {
      "name": "miso paste",
      "amount": "2 tbsp"
    },
    {
      "name": "soy sauce",
      "amount": "1 tbsp"
    },
    {
      "name": "agave syrup",
      "amount": "1 tbsp"
    },
    {
      "name": "lime juice",
      "amount": "1 tsp"
    },
    {
      "name": "kaffir lime leaf",
      "amount": "1 tsp",
      "notes": "finely chopped"
    },
    {
      "name": "cheddar cheese",
      "amount": "1 cup",
      "notes": "shredded"
    },
    {
      "name": "chili flakes",
      "amount": "1 tsp"
    },
    {
      "name": "vegetable oil",
      "amount": "1 tbsp"
    }
  ],
  "instructions": [
    "Heat 1 tbsp oil in a skillet over medium-high until shimmering.",
    "Add tofu cubes, cook until golden brown on all sides, about 4 minutes per side, then remove.",
    "Whisk miso paste, soy sauce, agave syrup, lime juice, chili flakes and chopped kaffir lime leaf in a bowl.",
    "Toss the cooked tofu in the miso mixture until evenly coated.",
    "Warm the fresh agave leaf in a dry skillet for 30 seconds to make it pliable.",
    "Place a spoonful of tofu onto the center of the leaf, top with shredded cheese, and fold sides.",
    "Wrap tightly, allowing the cheese to melt slightly over the tofu.",
    "Serve immediately, optionally drizzled with extra lime juice."
  ],
