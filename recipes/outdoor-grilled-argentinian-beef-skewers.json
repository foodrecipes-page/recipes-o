{
  "title": "Outdoor Grilled Argentinian Beef Skewers",
  "description": "A kid-friendly Argentinian dish featuring Chinese five spice powder, this recipe is perfect for a flexitarian-friendly outdoor gathering, with umami and juicy flavors.",
  "cuisine": "Argentinian",
  "diet": [
    "flexitarian"
  ],
