  "ingredients": [
    {
      "name": "beef sirloin",
      "amount": "1 pound",
      "notes": "cut into 1-inch cubes"
    },
    {
      "name": "Chinese five spice powder",
      "amount": "2 tablespoons"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "red bell pepper",
      "amount": "1",
      "notes": "cut into 1-inch pieces"
    },
    {
      "name": "onion",
      "amount": "1",
      "notes": "cut into 1-inch pieces"
    },
    {
      "name": "zucchini",
      "amount": "1",
      "notes": "cut into 1-inch slices"
    }
  ],
  "instructions": [
    "Preheat the grill to medium-high heat, about 400 degrees Fahrenheit.",
    "In a large bowl, whisk together Chinese five spice powder, olive oil, garlic, salt, and black pepper.",
    "Add the beef cubes to the bowl and toss to coat with the marinade.",
    "Thread the beef cubes, red bell pepper, onion, and zucchini onto skewers, leaving a small space between each piece.",
    "Grill the skewers for 10-12 minutes, turning occasionally, until the beef is cooked to an internal temperature of 145 degrees Fahrenheit.",
    "Let the skewers rest for 5 minutes before serving.",
    "Serve hot and enjoy."
  ],
