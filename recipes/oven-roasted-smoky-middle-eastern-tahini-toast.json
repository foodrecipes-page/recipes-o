      "amount": "1 tbsp"
    },
    {
      "name": "garlic, minced",
      "amount": "1 clove"
    },
    {
      "name": "fresh parsley, chopped",
      "amount": "1/4 cup"
    },
    {
      "name": "toasted pine nuts",
      "amount": "1 tbsp"
    },
    {
      "name": "pomegranate molasses",
      "amount": "1 tbsp"
    },
    {
      "name": "salt",
      "amount": "to taste"
    }
  ],
  "instructions": [
    "Preheat the oven to 200C.",
    "Place the pita slices on a baking sheet and bake until crisp, about 5 to 7 minutes.",
    "Brush one side of each warm pita slice with olive oil.",
    "Whisk the tahini, lemon juice, minced garlic and salt in a small bowl until smooth.",
    "Spread the tahini mixture evenly over each pita slice.",
    "Sprinkle smoked paprika, ground cumin and sumac over the tahini.",
    "Drizzle pomegranate molasses over the spices.",
    "Return the bread to the oven and bake for 3 to 4 minutes until golden and fragrant.",
    "Remove from the oven and top with chopped parsley and toasted pine nuts.",
    "Serve immediately while warm."
  ],
