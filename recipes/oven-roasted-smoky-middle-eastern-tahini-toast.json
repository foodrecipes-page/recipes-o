{
  "title": "Oven‑Roasted Smoky MiddleEastern Tahini Toast",
  "description": "A lazy‑Sunday MiddleEastern snack that pairs crispy pita with creamy tahini, smoky spices and a touch of pomegranate sweetness.",
  "cuisine": "Middle Eastern",
  "diet": [
    "vegan"
  ],
