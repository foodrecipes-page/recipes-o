    {
      "name": "whole wheat pita bread",
      "amount": "4 slices"
    },
    {
      "name": "tahini",
      "amount": "2 tbsp"
    },
    {
      "name": "lemon juice",
      "amount": "1 tbsp"
    },
    {
      "name": "smoked paprika",
      "amount": "1 tsp"
    },
    {
      "name": "ground cumin",
      "amount": "1 tsp"
    },
    {
