  "ingredients": [
    {
      "name": "chickpeas",
      "amount": "1 15 ounce can"
    },
    {
      "name": "red onion",
      "amount": "1/2 cup",
      "notes": "thinly sliced"
    },
    {
      "name": "red bell pepper",
      "amount": "1/2 cup",
      "notes": "thinly sliced"
    },
    {
      "name": "garlic",
      "amount": "2 cloves",
      "notes": "minced"
    },
    {
      "name": "lemon juice",
      "amount": "2 tablespoons"
    },
    {
      "name": "olive brine",
      "amount": "2 tablespoons"
    },
    {
      "name": "dried oregano",
      "amount": "1 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon"
    }
  ],
  "instructions": [
    "Drain the chickpeas and rinse with water.",
    "In a large bowl, whisk together lemon juice, olive brine, garlic, oregano, salt, and black pepper.",
    "Add the sliced red onion and red bell pepper to the bowl and toss to coat with the marinade.",
    "Add the chickpeas to the bowl and toss to combine.",
    "Cover the bowl with plastic wrap and refrigerate for at least 30 minutes to allow the flavors to meld.",
    "Just before serving, sprinkle the top of the salad with a pinch of salt and pepper to taste.",
    "Serve chilled, garnished with additional oregano if desired."
  ],
