{
  "title": "Olive Chickpea Delight",
  "description": "A silky, pungent Greek chickpea salad featuring chickpeas marinated in a brine of olive oil, lemon juice, garlic, and oregano.",
  "cuisine": "Greek",
  "diet": [
    "vegan",
