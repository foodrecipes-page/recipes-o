{
  "title": "Jeju Style Truffle Rice Balls",
  "description": "Resinous and springy Korean rice onigiri with truffle oil, shaped like nigiri and friendly to ayurvedic tamasic diets",
  "cuisine": "Korean",
  "diet": [
    "vegetarian",
    "gluten-free"
  ],
  "meal": "snack",
  "ingredients": [
    {
      "name": "Korean rice",
      "amount": "2 cups",
      "notes": "short grain"
    },
    {
      "name": "Truffle oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "Sesame oil",
      "amount": "1 tablespoon"
    },
    {
      "name": "Salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "Sugar",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "Rice vinegar",
      "amount": "1 tablespoon"
    },
    {
      "name": "Water",
      "amount": "1 cup"
    },
    {
      "name": "Noru seaweed",
      "amount": "1 sheet",
      "notes": "dried"
    },
    {
      "name": "Sesame seeds",
      "amount": "1 tablespoon"
    }
  ],
  "instructions": [
    "Rinse the Korean rice thoroughly and soak it in water for 4 hours",
    "Drain and cook the rice with 1 cup of water in a medium saucepan over low heat",
    "In a small bowl, mix truffle oil, sesame oil, salt, sugar, and rice vinegar",
    "Once the rice is cooked, allow it to cool down to room temperature",
    "Mix the cooled rice with the truffle oil mixture until well combined",
    "Cut the noru seaweed into small pieces and mix with the rice",
    "Wet your hands with water and shape the rice mixture into small balls",
    "Roll each ball in sesame seeds to coat",
    "Serve the rice balls at room temperature"
  ],
