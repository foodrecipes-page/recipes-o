    {
      "name": "olive oil",
      "amount": "2 tablespoons",
      "notes": "extra virgin"
    }
  ],
  "instructions": [
    "Preheat the oven to 400 degrees Fahrenheit.",
    "In a large cataplana vessel, heat the olive oil over medium heat.",
    "Add the chopped onion and cook until softened, about 5 minutes.",
    "Add the minced garlic and cook for an additional minute.",
    "Add the chopped carrots, zucchini, and red bell pepper, and cook for 5 minutes, stirring occasionally.",
    "Add the white wine, vegetable broth, bonito flakes, and bouquet garni to the vessel.",
    "Cover the vessel with a lid and transfer it to the preheated oven.",
    "Roast the stew in the oven for 25 minutes, or until the vegetables are tender.",
    "Remove the vessel from the oven and let it cool slightly.",
    "Serve the stew hot, garnished with additional thyme and rosemary if desired."
  ],
