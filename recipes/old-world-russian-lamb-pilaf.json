    {
      "name": "lamb shoulder",
      "amount": "1.5 pounds",
      "notes": "cut into 1-inch pieces"
    },
    {
      "name": "saffron threads",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "shio-cure salt",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "long-grain rice",
      "amount": "1 cup"
    },
    {
      "name": "olive oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "dried thyme",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "chicken broth",
      "amount": "2 cups"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon"
    }
  ],
  "instructions": [
    "Heat the olive oil in a large saucepan over medium heat.",
    "Add the chopped onion and cook until softened, about 5 minutes.",
    "Add the minced garlic and cook for an additional minute.",
    "Add the lamb pieces and cook until browned on all sides, about 5 minutes.",
    "Add the saffron threads, shio-cure salt, thyme, and black pepper, stirring to combine.",
    "Add the long-grain rice and stir to coat the rice with the oil and mix with the lamb and spices.",
    "Add the chicken broth and bring to a boil.",
    "Reduce the heat to low, cover, and simmer for 20 minutes or until the rice is tender and the liquid has been absorbed.",
    "Fluff the pilaf with a fork and serve hot."
  ],
