{
  "title": "Oven Roasted Polish Lamb Skewers",
  "description": "A kid-friendly Polish dish featuring lamb, yuzu-cure, and a sweet earthy flavor, served with a glassy-jelly sauce",
  "cuisine": "Polish",
  "diet": [
    "gluten-free"
  ],
  "meal": "dinner",
  "ingredients": [
    {
      "name": "lamb shoulder",
      "amount": "1 pound",
      "notes": "cut into 1-inch cubes"
    },
    {
      "name": "yuzu juice",
      "amount": "1/4 cup"
    },
    {
      "name": "olive oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "honey",
      "amount": "2 tablespoons"
    },
    {
      "name": "dried thyme",
      "amount": "1 teaspoon"
    },
    {
      "name": "garlic powder",
      "amount": "1 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "wooden skewers",
      "amount": "10-12",
      "notes": "soaked in water for 30 minutes"
    },
    {
      "name": "glassy-jelly sauce",
      "amount": "1 cup",
      "notes": "homemade or store-bought"
    }
  ],
  "instructions": [
    "Preheat the oven to 400 degrees Fahrenheit",
    "In a large bowl, whisk together yuzu juice, olive oil, honey, thyme, garlic powder, salt, and black pepper",
    "Add the lamb cubes to the bowl and toss to coat with the marinade",
    "Thread 3-4 lamb cubes onto each wooden skewer",
    "Place the skewers on a baking sheet lined with parchment paper",
    "Roast the skewers in the oven for 15-20 minutes, or until cooked through",
    "While the skewers are cooking, heat the glassy-jelly sauce in a small saucepan over low heat",
    "Serve the skewers hot with the warm glassy-jelly sauce",
    "Garnish with fresh thyme and serve immediately"
  ],
