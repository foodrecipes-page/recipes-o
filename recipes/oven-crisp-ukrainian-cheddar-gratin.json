{
  "title": "Oven Crisp Ukrainian Cheddar Gratin",
  "description": "A floral, crisp Ukrainian show-off dish featuring mature cheddar, steam, and vegetarian-friendly ingredients.",
  "cuisine": "Ukrainian",
  "diet": [
    "vegetarian"
  ],
  "meal": "dinner",
  "ingredients": [
    {
      "name": "shredded mature cheddar cheese",
      "amount": "1 cup",
      "notes": "mature cheddar for strong flavor"
    },
    {
      "name": "frozen mixed flower vegetables",
      "amount": "1 cup",
      "notes": "use a mix of radish, carrot, and beet blossoms for color"
    },
    {
      "name": "heavy cream",
      "amount": "1 cup"
    },
    {
      "name": "breadcrumbs",
      "amount": "1/4 cup",
      "notes": "helps crisp the top"
    },
    {
      "name": "chopped fresh dill",
      "amount": "1 tablespoon",
      "notes": "adds a floral hint"
    },
    {
      "name": "smoked paprika",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "freshly ground black pepper",
      "amount": "pinch"
    }
  ],
  "instructions": [
    "Preheat oven to 375°F (190°C).",
    "In a large skillet, heat heavy cream over medium until warm, then remove from heat.",
    "Stir shredded cheddar into warm cream until melted and smooth.",
    "Fold in frozen mixed flower vegetables, smoked paprika, salt, pepper, and dill.",
    "Transfer mixture to a greased 8x8-inch baking dish.",
    "Sprinkle breadcrumbs evenly over the top.",
    "Bake for 25 minutes or until the top is golden brown and the gratin is bubbling.",
    "Let rest for 5 minutes before serving."
  ],
