      "name": "boneless chicken breast",
      "amount": "1 pound",
      "notes": "cut into bite-sized pieces"
    },
    {
      "name": "coconut milk",
      "amount": "1 can",
      "notes": "full-fat"
    },
    {
      "name": "coconut cream",
      "amount": "1/2 cup",
      "notes": "chilled"
    },
    {
      "name": "red curry paste",
      "amount": "2 tablespoons",
      "notes": "Thai-style"
    },
    {
      "name": "fish sauce",
      "amount": "1 tablespoon",
      "notes": "optional"
    },
    {
      "name": "brown sugar",
      "amount": "1 tablespoon",
      "notes": "or to taste"
    },
    {
      "name": "fresh Thai basil",
      "amount": "1/4 cup",
      "notes": "chopped"
    },
    {
      "name": "fresh cilantro",
      "amount": "1/4 cup",
      "notes": "chopped"
    },
    {
      "name": "lime juice",
      "amount": "2 tablespoons",
      "notes": "freshly squeezed"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon",
      "notes": "or to taste"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon",
      "notes": "or to taste"
    }
  ],
  "instructions": [
    "Heat oil in a large pan over medium heat",
    "Add the red curry paste and cook for 1 minute",
    "Add the chicken and cook until browned",
    "Add the coconut milk and fish sauce and bring to a simmer",
    "Reduce the heat to low and cook for 10 minutes",
    "Stir in the coconut cream and cook for an additional 2 minutes",
    "Add the brown sugar, Thai basil, cilantro, lime juice, salt, and black pepper and stir to combine",
    "Taste and adjust the seasoning as needed",
    "Serve hot over rice or noodles",
    "Ensure poultry is cooked to an internal temperature of 74°C / 165°F (juices run clear, no pink remaining) before serving."
  ],
