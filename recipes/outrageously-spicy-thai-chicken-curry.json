{
  "title": "Outrageously Spicy Thai Chicken Curry",
  "description": "A peppery and chewy Thai chicken curry featuring coconut milk and coconut cream, perfect for a date night dinner",
  "cuisine": "Thai",
  "diet": [
    "gluten-free"
  ],
