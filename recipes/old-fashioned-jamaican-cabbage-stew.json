      "amount": "1 teaspoon"
    },
    {
      "name": "Black pepper",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "Vegetable oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "Vegetable broth",
      "amount": "2 cups"
    }
  ],
  "instructions": [
    "Heat the oil in a large pot over medium heat.",
    "Add the chopped onion and saute until it is translucent.",
    "Add the minced garlic and diced scotch bonnet pepper and saute for another minute.",
    "Add the katsuramuki-cut cabbage, salt, and black pepper, and stir to combine.",
    "Add the thyme and vegetable broth, and bring the mixture to a boil.",
    "Reduce the heat to low and simmer the stew for 20 minutes.",
    "Serve the stew hot, garnished with additional thyme if desired."
  ],
