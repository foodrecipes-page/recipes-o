{
  "title": "Outdoor Grilled Kenyan Lamb Kebabs",
  "description": "A quick and flavorful Kenyan dish featuring lamb, english mustard, and a mediterranean friendly mother sauce base, perfect for outdoor grilling.",
  "cuisine": "Kenyan",
