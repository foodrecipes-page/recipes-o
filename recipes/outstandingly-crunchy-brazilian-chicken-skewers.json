  "ingredients": [
    {
      "name": "chicken breast",
      "amount": "1 pound",
      "notes": "cut into 1-inch pieces"
    },
    {
      "name": "ginger cordial",
      "amount": "1/4 cup"
    },
    {
      "name": "pickle juice",
      "amount": "2 tablespoons"
    },
    {
      "name": "olive oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "chopped pecans",
      "amount": "1/4 cup"
    },
    {
      "name": "parsley",
      "amount": "1/4 cup",
      "notes": "chopped"
    }
  ],
  "instructions": [
    "Preheat the grill to 400 degrees Fahrenheit.",
    "In a large bowl, whisk together ginger cordial, pickle juice, olive oil, salt, and black pepper.",
    "Add the chicken to the bowl and marinate for at least 30 minutes.",
    "Thread the marinated chicken onto skewers, leaving a small space between each piece.",
    "Sprinkle the chopped pecans over the chicken.",
    "Grill the skewers for 10-12 minutes, turning occasionally, until the chicken is cooked through.",
    "Garnish with parsley and serve immediately."
  ],
