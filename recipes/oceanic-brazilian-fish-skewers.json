  "ingredients": [
    {
      "name": "Mahi Mahi fillets",
      "amount": "1 pound",
      "notes": "cut into 1 inch pieces"
    },
    {
      "name": "almond flour",
      "amount": "1/2 cup"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "lemon juice",
      "amount": "2 tablespoons"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "parsley",
      "amount": "1/4 cup",
      "notes": "chopped"
    }
  ],
  "instructions": [
    "Preheat grill to 400 degrees Fahrenheit.",
    "In a large bowl, whisk together almond flour, garlic, lemon juice, salt, and black pepper.",
    "Add the Mahi Mahi pieces to the bowl and toss to coat evenly with the almond flour mixture.",
    "Thread the coated fish pieces onto skewers, leaving a small space between each piece.",
    "Brush the skewers with olive oil and sprinkle with parsley.",
    "Grill the skewers for 8-10 minutes, turning occasionally, until the fish is cooked through and flakes easily with a fork.",
    "Serve the skewers hot, garnished with additional parsley if desired."
  ],
