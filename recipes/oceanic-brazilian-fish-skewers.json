{
  "title": "Oceanic Brazilian Fish Skewers",
  "description": "A garlicky and flaky Brazilian dish featuring almond flour, this pescatarian-friendly recipe is perfect for adventurous eaters, emulsifying flavors of the ocean with every bite.",
  "cuisine": "Brazilian",
  "diet": [
    "pescatarian"
  ],
