      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "fresh parsley",
      "amount": "1/4 cup",
      "notes": "chopped"
    }
  ],
  "instructions": [
    "Preheat the oven to 375 degrees Fahrenheit.",
    "In a large bowl, mix together the canned beans, shio-koji, olive oil, onion, garlic, tomato paste, lemon juice, salt, and black pepper.",
    "Transfer the mixture to a 9x13 inch baking dish.",
    "Bake the casserole in the preheated oven for 30 minutes.",
    "Remove the casserole from the oven and sprinkle with chopped fresh parsley.",
    "Return the casserole to the oven and bake for an additional 10 minutes.",
    "Remove the casserole from the oven and let it cool for a few minutes before serving.",
    "Serve the casserole hot, garnished with additional parsley if desired."
  ],
