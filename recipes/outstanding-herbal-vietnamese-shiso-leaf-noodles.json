      "name": "turmeric",
      "amount": "1 tsp"
    },
    {
      "name": "salt",
      "amount": "1 tsp"
    }
  ],
  "instructions": [
    "Bring the vegetable broth to a boil in a large pot.",
    "Add the grated ginger and minced garlic to the pot and cook for 5 minutes.",
    "Add the rice noodles to the pot and cook according to the package instructions.",
    "In a small bowl, mix together the coconut oil, turmeric, and salt.",
    "Add the shiso leaves to the bowl and toss to coat with the oil mixture.",
    "Drain the noodles and add them to the bowl with the shiso leaves.",
    "Toss everything together to combine.",
    "Serve the noodles hot, garnished with additional shiso leaves if desired."
  ],
