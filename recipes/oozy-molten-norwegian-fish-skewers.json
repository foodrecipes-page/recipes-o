  "ingredients": [
    {
      "name": "cod fish",
      "amount": "1 pound",
      "notes": "cut into 1 inch cubes"
    },
    {
      "name": "fish sauce",
      "amount": "1/4 cup"
    },
    {
      "name": "aejeot sauce",
      "amount": "2 tablespoons"
    },
    {
      "name": "brown sugar",
      "amount": "1 tablespoon"
    },
    {
      "name": "ginger",
      "amount": "1 tablespoon",
      "notes": "grated"
    },
    {
      "name": "lemon juice",
      "amount": "2 tablespoons"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup"
    },
    {
      "name": "bamboo skewers",
      "amount": "10",
      "notes": "soaked in water for 30 minutes"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    }
  ],
  "instructions": [
    "Preheat the grill to medium high heat.",
    "In a large bowl, whisk together fish sauce, aejeot sauce, brown sugar, ginger, lemon juice, salt and black pepper.",
    "Add the cod fish cubes to the bowl and marinate for 30 minutes.",
    "Thread the marinated fish cubes onto the bamboo skewers.",
    "Brush the skewers with olive oil and grill for 8 minutes per side.",
    "Serve the skewers hot with additional aejeot sauce for dipping.",
    "Garnish with lemon wedges and chopped fresh parsley.",
    "Let the skewers rest for 2 minutes before serving."
  ],
