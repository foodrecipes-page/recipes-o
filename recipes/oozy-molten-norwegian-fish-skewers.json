{
  "title": "Oozy Molten Norwegian Fish Skewers",
  "description": "Tangy and molten Norwegian dish featuring fish, sauce and cure, friendly to ayurvedic tamasic diet",
  "cuisine": "Norwegian",
  "diet": [
    "pescatarian",
    "gluten-free"
  ],
