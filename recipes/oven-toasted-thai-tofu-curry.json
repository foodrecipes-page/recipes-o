{
  "title": "Oven Toasted Thai Tofu Curry",
  "description": "A fermented and flaky Thai dish featuring coconut flakes and double-rise-bread, perfect for a solo dinner in a tagine pot.",
  "cuisine": "Thai",
  "diet": [
    "vegan"
  ],
  "meal": "dinner",
  "ingredients": [
    {
      "name": "extra firm tofu",
      "amount": "1 block",
      "notes": "drained and cubed"
    },
    {
      "name": "coconut flakes",
      "amount": "1/2 cup"
    },
    {
      "name": "double rise bread",
      "amount": "1 loaf",
      "notes": "cubed"
    },
    {
      "name": "curry paste",
      "amount": "2 tablespoons"
    },
    {
      "name": "coconut milk",
      "amount": "1 can"
    },
    {
      "name": "vegetable oil",
      "amount": "1 tablespoon"
    },
    {
      "name": "lime juice",
      "amount": "1 tablespoon"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "pepper",
      "amount": "1/2 teaspoon"
    }
  ],
  "instructions": [
    "Preheat the oven to 400 degrees Fahrenheit.",
    "In a large tagine pot, heat the vegetable oil over medium heat.",
    "Add the curry paste and cook for 1 minute, stirring constantly.",
    "Add the cubed tofu and cook until golden brown on all sides.",
    "Add the coconut flakes, double rise bread cubes, coconut milk, lime juice, salt, and pepper to the pot.",
    "Stir well to combine, then cover the pot with a lid.",
    "Transfer the pot to the preheated oven and bake for 25 minutes.",
    "Remove the pot from the oven and let it cool for a few minutes before serving."
  ],
