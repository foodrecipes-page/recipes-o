{
  "title": "Oven-Roasted Malaysian Horseradish Pudding",
  "description": "A resinous, pillowy pudding with a sharp horseradish kick, infused with diced katsuramuki for texture, perfect for festive occasions.",
  "cuisine": "Malaysian",
  "diet": null,
  "meal": "dessert",
  "ingredients": [
    {
      "name": "Horseradish root",
      "amount": "150 g",
      "notes": "peeled and grated"
    },
    {
      "name": "Katsuramuki (Japanese cucumber)",
      "amount": "200 g",
      "notes": "diced"
    },
    {
      "name": "Eggs",
      "amount": "4 large"
    },
    {
      "name": "Milk",
      "amount": "200 ml"
    },
    {
      "name": "Coconut milk",
      "amount": "200 ml"
    },
    {
      "name": "All-purpose flour",
      "amount": "80 g"
    },
    {
      "name": "Sugar",
      "amount": "120 g"
    },
    {
      "name": "Salt",
      "amount": "1 tsp"
    },
    {
      "name": "Baking powder",
      "amount": "1 tsp"
    },
    {
      "name": "Ground black pepper",
      "amount": "1/4 tsp"
    }
  ],
  "instructions": [
    "Preheat the oven to 180°C.",
    "In a large bowl, whisk eggs, milk, coconut milk, sugar, salt, and pepper until combined.",
    "Stir in flour and baking powder until the batter is smooth.",
    "Fold in grated horseradish and diced katsuramuki.",
    "Grease a 20 cm square baking dish with butter.",
    "Pour the batter into the dish and smooth the top with a spatula.",
    "Bake for 35 minutes or until the pudding is puffed and golden.",
    "Let the pudding cool for 10 minutes before slicing and serving."
  ],
