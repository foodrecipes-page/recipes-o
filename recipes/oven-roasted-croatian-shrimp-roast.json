      "amount": "1/2 teaspoon"
    },
    {
      "name": "carrots",
      "amount": "2 medium",
      "notes": "peeled and chopped"
    },
    {
      "name": "zucchini",
      "amount": "1 medium",
      "notes": "chopped"
    }
  ],
  "instructions": [
    "Preheat the oven to 425 degrees Fahrenheit.",
    "Season the shrimp with paprika, salt, and black pepper.",
    "Heat the olive oil on the salt block over medium-high heat.",
    "Add the garlic and cook for 1 minute until fragrant.",
    "Add the shrimp and cook for 2 minutes per side until pink and cooked through.",
    "Add the carrots and zucchini to the salt block and cook for 3 minutes until tender.",
    "Transfer the salt block to the preheated oven and roast for 10 minutes.",
    "Remove from the oven and squeeze the lemon juice over the top.",
    "Serve hot and enjoy."
  ],
