  "ingredients": [
    {
      "name": "Carnaroli rice",
      "amount": "1 1/2 cups",
      "notes": "preferably fresh"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "chopped"
    },
    {
      "name": "carrot",
      "amount": "2 medium",
      "notes": "peeled and chopped"
    },
    {
      "name": "celery",
      "amount": "2 stalks",
      "notes": "chopped"
    },
    {
      "name": "mushroom",
      "amount": "1 cup",
      "notes": "sliced"
    },
    {
      "name": "vegetable broth",
      "amount": "2 cups",
      "notes": "low sodium"
    },
    {
      "name": "olive oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "fresh parsley",
      "amount": "1/4 cup",
      "notes": "chopped"
    }
  ],
  "instructions": [
    "Preheat the oven to 400 degrees Fahrenheit.",
    "In a large bowl, mix together the Carnaroli rice, chopped onion, carrot, celery, and mushroom.",
    "In a separate bowl, whisk together the vegetable broth, olive oil, salt, and black pepper.",
    "Add the wet ingredients to the dry ingredients and stir until the rice is well coated.",
    "Transfer the mixture to a 9x13 inch baking dish and cover with aluminum foil.",
    "Bake for 30 minutes, then remove the foil and continue baking for an additional 20 minutes, or until the top is crispy and golden brown.",
    "Remove from the oven and sprinkle with chopped fresh parsley.",
    "Let it rest for 5 minutes before serving.",
    "Serve hot and enjoy."
  ],
