{
  "title": "Oven Crispy Irish Carnaroli Rice Pilaf",
  "description": "Savory and crispy Irish dish featuring Carnaroli rice, perfect for a monsoon evening, this egg-free friendly recipe is sure to delight.",
  "cuisine": "Irish",
  "diet": [
    "vegetarian",
    "gluten-free"
  ],
