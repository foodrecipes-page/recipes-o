      "name": "all-purpose flour",
      "amount": "2 cups"
    },
    {
      "name": "almond milk",
      "amount": "1/2 cup"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup"
    },
    {
      "name": "maple syrup",
      "amount": "2 tablespoons"
    },
    {
      "name": "lemon juice",
      "amount": "1 tablespoon"
    },
    {
      "name": "salt",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "scalloped shell vessels",
      "amount": "6",
      "notes": "for serving"
    }
  ],
  "instructions": [
    "Preheat the oven to 400 degrees Fahrenheit.",
    "In a large bowl, whisk together the flour, almond milk, olive oil, maple syrup, lemon juice, and salt.",
    "Gently fold in the thawed mixed berries.",
    "Spoon the mixture into the scalloped shell vessels.",
    "Place the vessels on a baking sheet lined with parchment paper.",
    "Roast in the preheated oven for 25 minutes.",
    "Remove from the oven and let cool for 5 minutes.",
    "Serve warm, garnished with additional mixed berries if desired."
