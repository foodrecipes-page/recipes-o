  "instructions": [
    "preheat the oven to 425f.",
    "peel and dice the beets.",
    "heat the avocado oil in a tajine or clay vessel over medium heat.",
    "add the onion and cook until softened, about 5 minutes.",
    "add the garlic and cook for another minute.",
    "add the cumin, coriander, black pepper, and salt, and stir to combine.",
    "add the diced beets and stir to coat with the spice mixture.",
    "cover the vessel and transfer to the preheated oven.",
    "roast the beets for 30 minutes, or until tender when pierced.",
    "stir in the chopped cilantro, lemon juice, honey, and cayenne pepper.",
    "return the vessel to the oven and roast for another 5 minutes.",
    "remove the vessel from the oven and let cool slightly.",
    "serve the oven-roasted beets hot, garnished with additional cilantro if desired.",
    "adjust seasoning to taste.",
    "serve immediately and enjoy!"
  ],
