      "amount": "1 small head",
      "notes": "shredded"
    },
    {
      "name": "tomato paste",
      "amount": "2 tablespoons"
    },
    {
      "name": "infuse oil",
      "amount": "1 tablespoon"
    },
    {
      "name": "bicarbonate of soda",
      "amount": "1 teaspoon"
    },
    {
      "name": "beef broth",
      "amount": "4 cups"
    },
    {
      "name": "sour cream",
      "amount": "1 cup",
      "notes": "optional"
    }
  ],
  "instructions": [
    "In a large pot, heat the infuse oil over medium heat.",
    "Add the chopped onion and cook until softened, about 5 minutes.",
    "Add the grated carrots and beets, and cook for an additional 5 minutes.",
    "Add the shredded cabbage, and cook until it starts to soften.",
    "Add the beef brisket, tomato paste, bicarbonate of soda, and beef broth to the pot.",
    "Bring the mixture to a boil, then reduce the heat to low and simmer for 1 hour.",
    "Season the borscht with salt and pepper to taste.",
    "Serve the borscht hot, with a dollop of sour cream on top if desired."
  ],
