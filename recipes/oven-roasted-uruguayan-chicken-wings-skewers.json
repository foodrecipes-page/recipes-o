      "name": "chicken wings",
      "amount": "2 pounds",
      "notes": "drumettes and flats separated"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup"
    },
    {
      "name": "lime juice",
      "amount": "2 tablespoons"
    },
    {
      "name": "garlic powder",
      "amount": "1 teaspoon"
    },
    {
      "name": "paprika",
      "amount": "1 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "chimichurri sauce",
      "amount": "1/4 cup",
      "notes": "store-bought or homemade"
    },
    {
      "name": "fresh parsley",
      "amount": "1/4 cup",
      "notes": "chopped"
    }
  ],
  "instructions": [
    "Preheat the oven to 400 degrees Fahrenheit.",
    "In a large bowl, whisk together olive oil, lime juice, garlic powder, paprika, salt, and black pepper.",
    "Add the chicken wings to the bowl and toss to coat with the marinade.",
    "Thread 2-3 chicken wings onto each skewer, leaving a small space between each wing.",
    "Place the skewers on a baking sheet lined with parchment paper.",
    "Roast the chicken wings in the preheated oven for 25-30 minutes or until cooked through.",
    "Brush the chicken wings with chimichurri sauce during the last 5 minutes of cooking.",
    "Garnish with chopped fresh parsley and serve hot."
  ],
