      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup"
    },
    {
      "name": "salt",
      "amount": "1 tsp"
    },
    {
      "name": "black pepper",
      "amount": "1 tsp"
    }
  ],
  "instructions": [
    "Preheat the oven to 400 degrees Fahrenheit.",
    "In a large bowl, whisk together olive oil, salt, and black pepper.",
    "Add the bacon lardon, chicken breast, red onion, red bell pepper, and garlic to the bowl and toss to coat.",
    "Thread the ingredients onto skewers, leaving a small space between each piece.",
    "Place the skewers on a baking sheet lined with parchment paper.",
    "Roast in the preheated oven for 25 minutes, or until the chicken is cooked through.",
    "Remove from the oven and let rest for 5 minutes.",
    "Serve hot and enjoy."
  ],
