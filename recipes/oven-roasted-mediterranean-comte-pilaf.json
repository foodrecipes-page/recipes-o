      "notes": "aged 6 months"
    },
    {
      "name": "fry-grind-rice-khao-khua",
      "amount": "2 cups",
      "notes": "toasted"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup"
    },
    {
      "name": "lemon juice",
      "amount": "2 tablespoons"
    },
    {
      "name": "chopped fresh parsley",
      "amount": "1/4 cup"
    },
    {
      "name": "chopped fresh mint",
      "amount": "1/4 cup"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    }
  ],
  "instructions": [
    "Preheat the oven to 400 degrees Fahrenheit.",
    "In a large bowl, combine the toasted fry-grind-rice-khao-khua, grated Comte cheese, olive oil, lemon juice, chopped parsley, chopped mint, salt, and black pepper.",
    "Mix well to combine.",
    "Transfer the mixture to a tagliere vessel.",
    "Roast in the preheated oven for 20 minutes.",
    "Remove from the oven and let cool for 5 minutes.",
    "Serve hot and enjoy.",
    "Garnish with additional parsley and mint if desired."
