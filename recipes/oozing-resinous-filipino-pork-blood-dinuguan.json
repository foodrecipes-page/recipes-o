      "name": "Pork Blood",
      "amount": "1 cup",
      "notes": "Fresh or store-bought"
    },
    {
      "name": "Pork Offal",
      "amount": "1/2 pound",
      "notes": "Pig's liver and heart"
    },
    {
      "name": "Onion",
      "amount": "1 medium",
      "notes": "Chopped"
    },
    {
      "name": "Garlic",
      "amount": "3 cloves",
      "notes": "Minced"
    },
    {
      "name": "Ginger",
      "amount": "2 inches",
      "notes": "Sliced"
    },
    {
      "name": "Black Pepper",
      "amount": "1/2 teaspoon",
      "notes": "Ground"
    },
    {
      "name": "Salt",
      "amount": "1/4 teaspoon",
      "notes": "Kosher"
    },
    {
      "name": "Molasses",
      "amount": "2 tablespoons",
      "notes": "Dark"
    },
    {
      "name": "Cedar Plank",
      "amount": "1 piece",
      "notes": "For smoking"
    },
    {
      "name": "Rice Vinegar",
      "amount": "2 tablespoons",
      "notes": "For marinade"
    }
  ],
  "instructions": [
    "Combine pork blood, pork offal, onion, garlic, ginger, black pepper, and salt in a large pot. Simmer over low heat for 10 minutes.",
    "Add molasses and cook for an additional 5 minutes, stirring occasionally.",
    "Meanwhile, prep the cedar plank by soaking it in water for 30 minutes.",
    "Remove the plank from water and place it on a heat-proof surface.",
    "Smoke the mixture over low heat for 10 minutes, or until fragrant.",
    "Remove the plank and discard.",
    "Stir in rice vinegar and cook for an additional minute.",
    "Serve warm over rice."
  ],
