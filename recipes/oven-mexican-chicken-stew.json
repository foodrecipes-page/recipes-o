  "ingredients": [
    {
      "name": "boneless chicken breast",
      "amount": "1 1/2 pounds",
      "notes": "cut into 1 inch pieces"
    },
    {
      "name": "sake",
      "amount": "1/4 cup"
    },
    {
      "name": "olive oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "cumin",
      "amount": "1 teaspoon"
    },
    {
      "name": "chili powder",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "diced tomatoes",
      "amount": "1 can"
    },
    {
      "name": "chicken broth",
      "amount": "1 cup",
      "notes": "low sodium"
    },
    {
      "name": "clay pot",
      "amount": "1"
    }
  ],
  "instructions": [
    "Preheat oven to 375 degrees Fahrenheit.",
    "Season the chicken breast pieces with cumin and chili powder.",
    "Heat olive oil in the clay pot over medium heat.",
    "Add the chopped onion and cook until softened.",
    "Add the minced garlic and cook for 1 minute.",
    "Add the chicken breast pieces and cook until browned.",
    "Add the sake and cook until the liquid is almost completely evaporated.",
    "Add the diced tomatoes and chicken broth, stir to combine.",
    "Cover the clay pot and transfer to the preheated oven.",
    "Bake for 30 minutes or until the chicken is cooked through."
  ],
