    {
      "name": "chwinamul",
      "amount": "2 cups",
      "notes": "parboiled and drained"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "ginger",
      "amount": "1 inch",
      "notes": "grated"
    },
    {
      "name": "soy sauce",
      "amount": "2 tablespoons"
    },
    {
      "name": "gochujang",
      "amount": "1 tablespoon"
    },
    {
      "name": "sesame oil",
      "amount": "1 tablespoon"
    },
    {
      "name": "water",
      "amount": "4 cups"
    },
    {
      "name": "tofu",
      "amount": "1 cup",
      "notes": "diced"
    },
    {
      "name": "green onions",
      "amount": "1/4 cup",
      "notes": "chopped"
    },
    {
      "name": "sesame seeds",
      "amount": "1 tablespoon"
    }
  ],
  "instructions": [
    "Heat the sesame oil in the clay pot over medium heat",
    "Add the minced garlic and grated ginger and saute until fragrant",
    "Add the parboiled chwinamul and stir to combine",
    "Add the soy sauce, gochujang, and water, and bring to a boil",
    "Reduce the heat to low and simmer for 20 minutes",
    "Add the diced tofu and cook for an additional 5 minutes",
    "Stir in the chopped green onions and sesame seeds",
    "Serve hot, garnished with additional green onions if desired"
  ],
