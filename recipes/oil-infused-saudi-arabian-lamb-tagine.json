      "amount": "1/4 cup",
      "notes": "pitted"
    },
    {
      "name": "ground cumin",
      "amount": "1 teaspoon"
    },
    {
      "name": "ground coriander",
      "amount": "1 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon"
    }
  ],
  "instructions": [
    "Heat the olive oil in a large cazuela over medium heat.",
    "Add the chopped onion and cook until it is softened and lightly browned.",
    "Add the minced garlic and cook for 1 minute, stirring constantly.",
    "Add the lamb pieces and cook until they are browned on all sides.",
    "Add the vegetable stock cubes, ground cumin, ground coriander, salt, and black pepper, and stir to combine.",
    "Add the chopped dried apricots and prunes, and stir to combine.",
    "Reduce heat to low and simmer, covered, for 1 1/2 hours, or until the lamb is tender.",
    "Serve the lamb and sauce hot, garnished with fresh herbs if desired."
  ],
