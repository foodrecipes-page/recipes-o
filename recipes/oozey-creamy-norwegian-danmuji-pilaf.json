    },
    {
      "name": "3 cloves garlic, minced",
      "amount": null
    },
    {
      "name": "1 onion, finely chopped",
      "amount": null
    },
    {
      "name": "2 cups of vegetable broth",
      "amount": 2
    },
    {
      "name": "2 tbsp butter or vegan alternative",
      "amount": 2
    },
    {
      "name": "1 tsp salt",
      "amount": 1
    },
    {
