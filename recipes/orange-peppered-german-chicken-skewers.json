{
  "title": "Orange Peppered German Chicken Skewers",
  "description": "A kid-friendly German dish featuring orange juice and kombu-cold-extract, with a peppery and crisp flavor profile, onion and garlic free.",
  "cuisine": "German",
  "diet": [
    "gluten-free",
    "low-carb"
  ],
  "meal": "dinner",
  "ingredients": [
    {
      "name": "chicken breast",
      "amount": "1 pound",
      "notes": "cut into 1 inch pieces"
    },
    {
      "name": "orange juice",
      "amount": "1/2 cup"
    },
    {
      "name": "kombu-cold-extract",
      "amount": "2 tablespoons"
    },
    {
      "name": "black pepper",
      "amount": "1 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup"
    },
    {
      "name": "lemon zest",
      "amount": "1 tablespoon"
    },
    {
      "name": "parsley",
      "amount": "1/4 cup",
      "notes": "chopped"
    }
  ],
  "instructions": [
    "Preheat the grill to 400 degrees Fahrenheit.",
    "In a large bowl, whisk together orange juice, kombu-cold-extract, black pepper, and salt.",
    "Add the chicken pieces to the bowl and marinate for at least 30 minutes.",
    "Thread the marinated chicken onto skewers, leaving a small space between each piece.",
    "Brush the skewers with olive oil and sprinkle with lemon zest.",
    "Grill the skewers for 10-12 minutes, turning occasionally, until the chicken is cooked through.",
    "Garnish with parsley and serve hot."
  ],
