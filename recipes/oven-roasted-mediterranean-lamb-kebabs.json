      "name": "lamb shoulder",
      "amount": "1 pound",
      "notes": "cut into 1 inch cubes"
    },
    {
      "name": "feta cheese",
      "amount": "1/2 cup",
      "notes": "crumbled"
    },
    {
      "name": "kalamata olives",
      "amount": "1/4 cup",
      "notes": "pitted"
    },
    {
      "name": "artichoke hearts",
      "amount": "1/4 cup",
      "notes": "canned"
    },
    {
      "name": "sun dried tomatoes",
      "amount": "1/4 cup",
      "notes": "packed in oil"
    },
    {
      "name": "fresh parsley",
      "amount": "1/4 cup",
      "notes": "chopped"
    },
    {
      "name": "lemon juice",
      "amount": "2 tablespoons"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup"
    },
    {
      "name": "garlic powder",
      "amount": "1 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon"
    }
  ],
  "instructions": [
    "Preheat the oven to 400 degrees Fahrenheit.",
    "In a large bowl, whisk together lemon juice, olive oil, garlic powder, salt, and black pepper.",
    "Add the lamb cubes to the bowl and toss to coat with the marinade.",
    "Thread the lamb cubes, feta cheese, olives, artichoke hearts, and sun dried tomatoes onto skewers.",
    "Place the skewers on a baking sheet lined with parchment paper.",
    "Roast the kebabs in the preheated oven for 20 minutes.",
    "Remove the kebabs from the oven and sprinkle with parsley.",
    "Return the kebabs to the oven and roast for an additional 5 minutes.",
    "Remove the kebabs from the oven and let rest for 5 minutes before serving."
  ],
