      "amount": "2 cups",
      "notes": "fresh or frozen"
    },
    {
      "name": "onions",
      "amount": "1 medium",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "tomatoes",
      "amount": "2 medium",
      "notes": "chopped"
    },
    {
      "name": "vegetable oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "water",
      "amount": "4 cups"
    }
  ],
  "instructions": [
    "Preheat the oven to 375 degrees Fahrenheit.",
    "In a large oven-safe pot, heat the oil over medium heat.",
    "Add the chopped onions and cook until they are translucent.",
    "Add the minced garlic and cook for an additional minute.",
    "Add the chopped tomatoes, sweetcorn, salt, and pepper, and stir to combine.",
    "Add the water to the pot and bring to a boil.",
    "Cover the pot and transfer it to the preheated oven.",
    "Simmer the stew in the oven for 30 minutes.",
    "Remove the pot from the oven and serve the stew hot."
  ],
