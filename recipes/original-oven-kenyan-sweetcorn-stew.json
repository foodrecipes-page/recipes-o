{
  "title": "Original Oven Kenyan Sweetcorn Stew",
  "description": "A sweet and comforting Kenyan dish featuring sweetcorn, this stew is perfect for a cold evening. It is a light and flavorful meal that is nut-free-friendly.",
  "cuisine": "Kenyan",
  "diet": [
    "gluten-free",
