{
  "title": "Oily Monsoon Croatian Boudin Blanc Pilaf",
  "description": "A pescatarian friendly Croatian dish featuring boudin blanc, fry grind rice, and monsoon spices, with a mustardy and chewy texture.",
  "cuisine": "Croatian",
  "diet": [
    "pescatarian"
  ],
