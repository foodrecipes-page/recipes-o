    {
      "name": "boudin blanc",
      "amount": "1 pound",
      "notes": "casings removed"
    },
    {
      "name": "fry grind rice",
      "amount": "2 cups"
    },
    {
      "name": "monsoon spices",
      "amount": "1 tablespoon"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup"
    },
    {
      "name": "mustard",
      "amount": "2 tablespoons"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "pepper",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "khao khuas",
      "amount": "1 cup",
      "notes": "fried shallots"
    },
    {
      "name": "scallions",
      "amount": "1/4 cup",
      "notes": "chopped"
    },
    {
      "name": "lemon juice",
      "amount": "2 tablespoons"
    }
  ],
  "instructions": [
    "Heat the olive oil in a large skillet over medium heat.",
    "Add the monsoon spices and cook for 1 minute, until fragrant.",
    "Add the boudin blanc and cook, breaking it up with a spoon, until no longer pink, about 5 minutes.",
    "Add the fry grind rice and cook, stirring constantly, for 2 minutes.",
    "Add the mustard, salt, and pepper, and stir to combine.",
    "Add the khao khuas and scallions, and stir to combine.",
    "Squeeze the lemon juice over the top and stir to combine.",
    "Transfer the pilaf to a serving platter and serve hot.",
    "Garnish with additional scallions and khao khuas, if desired."
  ],
