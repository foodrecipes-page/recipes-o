{
  "title": "Oven-roasted and aerated Norwegian minced pork Bake",
  "description": "A diabetic-friendly date-night dish featuring minced pork, perfect for a romantic evening in. This herbal, aerated bake is a twist on traditional Norwegian cuisine.",
  "cuisine": "Norwegian",
  "diet": [
    "diabetic-friendly"
  ],
