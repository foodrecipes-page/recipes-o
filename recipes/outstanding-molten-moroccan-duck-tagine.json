  "instructions": [
    "Preheat the oven to 300 degrees Fahrenheit",
    "Season the duck breast with salt and pepper",
    "Heat the olive oil in a large Dutch oven over medium heat",
    "Sear the duck breast until browned on all sides",
    "Remove the duck from the pot and set aside",
    "Add the chopped onion to the pot and cook until softened",
    "Add the minced garlic and grated ginger to the pot and cook for 1 minute",
    "Add the kombu cold extract, whole grain mustard, chicken broth, and honey to the pot",
    "Return the duck to the pot and bring to a boil",
    "Cover the pot and transfer to the preheated oven",
    "Braise the duck for 2 1/2 hours or until tender"
  ],
