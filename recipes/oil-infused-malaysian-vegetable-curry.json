  "instructions": [
    "Heat the oil in a large pan over medium heat.",
    "Add the onion and cook until it is softened and translucent.",
    "Add the garlic and ginger and cook for 1 minute.",
    "Add the carrots and potatoes and cook for 5 minutes.",
    "Add the green beans and cook until they are tender.",
    "Add the curry powder and peppercorns and cook for 1 minute.",
    "Pour in the coconut milk and bring the mixture to a simmer.",
    "Reduce the heat to low and cook for 10 minutes.",
    "Season with salt to taste.",
    "Serve hot over rice or with roti."
