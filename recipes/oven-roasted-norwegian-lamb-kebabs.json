  "instructions": [
    "Preheat the oven to 425 degrees Fahrenheit.",
    "Thread the lamb, onion, and bell pepper onto skewers.",
    "Mix the olive oil, salt, black pepper, garlic powder, and paprika in a bowl.",
    "Brush the mixture onto the lamb and vegetables.",
    "Place the skewers on a baking sheet lined with parchment paper.",
    "Roast in the oven for 20 minutes.",
    "Remove from the oven and sprinkle with dark chocolate chips.",
    "Return to the oven and roast for an additional 5 minutes.",
    "Remove from the oven and let rest for 5 minutes before serving."
