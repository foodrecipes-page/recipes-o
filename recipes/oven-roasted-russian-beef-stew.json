      "amount": "1 large",
      "notes": "chopped"
    },
    {
      "name": "carrots",
      "amount": "4 medium",
      "notes": "peeled and chopped"
    },
    {
      "name": "potatoes",
      "amount": "2 large",
      "notes": "peeled and chopped"
    },
    {
      "name": "mushrooms",
      "amount": "1 cup",
      "notes": "sliced"
    },
    {
      "name": "beef broth",
      "amount": "2 cups"
    },
    {
      "name": "olive oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "dried thyme",
      "amount": "1 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    }
  ],
  "instructions": [
    "Preheat the oven to 300 degrees Fahrenheit.",
    "Season the beef cubes with salt, black pepper, and dried thyme.",
    "Heat the olive oil in the ttukbaegi earthenware pot over medium-high heat.",
    "Add the beef cubes and cook until browned on all sides.",
    "Add the chopped onion, carrots, potatoes, and mushrooms to the pot.",
    "Pour in the beef broth and lemon juice, making sure that all the ingredients are covered.",
    "Cover the pot with a lid and transfer it to the preheated oven.",
    "Roast for 2 1/2 hours, or until the beef is tender and the vegetables are cooked through.",
    "Remove the pot from the oven and let it cool for a few minutes before serving."
  ],
