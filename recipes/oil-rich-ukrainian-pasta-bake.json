{
  "title": "Oil Rich Ukrainian Pasta Bake",
  "description": "A rich and flaky Ukrainian dish featuring penne pasta, perfect for a solo dinner, made in a stone bowl and friendly to ayurvedic tamasic diets.",
  "cuisine": "Ukrainian",
  "diet": [
