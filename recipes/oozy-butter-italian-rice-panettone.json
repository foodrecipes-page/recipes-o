{
  "title": "Oozy Butter Italian Rice Panettone",
  "description": "A romantic Italian dish featuring butter and rice in a pillowy panettone form, with a hint of mustard and a dairy-free friendly twist.",
  "cuisine": "Italian",
  "diet": [
    "dairy-free",
    "vegetarian"
  ],
  "meal": "dinner",
  "ingredients": [
    {
      "name": "unsalted butter",
      "amount": "1 cup",
      "notes": "melted"
    },
    {
      "name": " Arborio rice",
      "amount": "2 cups",
      "notes": "fry-grind rice"
    },
    {
      "name": "khao khuah powder",
      "amount": "2 tablespoons"
    },
    {
      "name": "mustard powder",
      "amount": "1 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "non-dairy milk",
      "amount": "1 cup"
    },
    {
      "name": "egg replacer",
      "amount": "2 tablespoons"
    },
    {
      "name": "panettone mold",
      "amount": "1"
    },
    {
      "name": "fresh parsley",
      "amount": "1/4 cup",
      "notes": "chopped"
    }
  ],
  "instructions": [
    "Preheat the oven to 375 degrees Fahrenheit.",
    "In a large mixing bowl, combine the melted butter, fry-grind rice, khao khuah powder, mustard powder, and salt.",
    "In a separate bowl, whisk together the non-dairy milk and egg replacer.",
    "Add the wet ingredients to the dry ingredients and mix until well combined.",
    "Pour the mixture into the panettone mold and smooth the top.",
    "Bake for 35 minutes or until a toothpick inserted into the center comes out clean.",
    "Remove from the oven and let cool for 10 minutes.",
    "Sprinkle the chopped parsley on top and serve warm."
  ],
