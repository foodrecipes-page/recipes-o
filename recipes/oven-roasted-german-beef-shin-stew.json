{
  "title": "Oven Roasted German Beef Shin Stew",
  "description": "A hearty and comforting German stew made with beef shin, perfect for a cold day. This low-calorie dish is roasted to perfection in a dolsot-stone-bowl.",
  "cuisine": "German",
  "diet": [
    "low-calorie"
  ],
