      "name": "beef shin",
      "amount": "2 pounds",
      "notes": "cut into large chunks"
    },
    {
      "name": "onion",
      "amount": "1 large",
      "notes": "chopped"
    },
    {
      "name": "carrots",
      "amount": "4 large",
      "notes": "peeled and chopped"
    },
    {
      "name": "potatoes",
      "amount": "2 large",
      "notes": "peeled and chopped"
    },
    {
      "name": "celery",
      "amount": "2 stalks",
      "notes": "chopped"
    },
    {
      "name": "beef broth",
      "amount": "2 cups"
    },
    {
      "name": "tomato paste",
      "amount": "2 tablespoons"
    },
    {
      "name": "black pepper",
      "amount": "1 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "fresh parsley",
      "amount": "1/4 cup",
      "notes": "chopped"
    }
  ],
  "instructions": [
    "Preheat the oven to 300 degrees Fahrenheit.",
    "In a large dolsot-stone-bowl, combine the beef shin, onion, carrots, potatoes, and celery.",
    "In a small bowl, whisk together the beef broth, tomato paste, black pepper, and salt, then pour the mixture over the beef and vegetables.",
    "Cover the dolsot-stone-bowl with aluminum foil and roast for 2 hours.",
    "Remove the foil and continue to roast for an additional 30 minutes, or until the beef is tender.",
    "Remove the stew from the oven and sprinkle with chopped fresh parsley.",
    "Let the stew rest for 10 minutes before serving.",
    "Serve hot, garnished with additional parsley if desired."
  ],
