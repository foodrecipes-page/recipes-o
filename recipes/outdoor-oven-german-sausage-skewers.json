      "name": "German sausage",
      "amount": "1 pound",
      "notes": "preferably Weisswurst or Bratwurst"
    },
    {
      "name": "doubanjiang",
      "amount": "2 tablespoons"
    },
    {
      "name": "bell peppers",
      "amount": "2 large"
    },
    {
      "name": "onions",
      "amount": "1 large"
    },
    {
      "name": "potatoes",
      "amount": "1 large"
    },
    {
      "name": "carrots",
      "amount": "2 large"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    }
  ],
  "instructions": [
    "Preheat the outdoor oven to 400 degrees Fahrenheit.",
    "Cut the German sausage into 1-inch pieces and set aside.",
    "Cut the bell peppers, onions, potatoes, and carrots into 1-inch pieces.",
    "Thread the sausage and vegetables onto skewers, leaving a small space between each piece.",
    "In a small bowl, mix together the doubanjiang, olive oil, salt, and black pepper.",
    "Brush the mixture onto the sausage and vegetables.",
    "Place the skewers on the yakimono-grill and cook for 20 minutes, turning occasionally.",
    "Serve hot and enjoy.",
    "Garnish with fresh parsley or chives, if desired."
  ],
