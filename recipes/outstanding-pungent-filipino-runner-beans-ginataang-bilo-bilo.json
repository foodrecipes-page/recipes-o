    }
  ],
  "instructions": [
    "Heat the oil in a large pot over medium heat.",
    "Add the chopped onion and saute until translucent.",
    "Add the minced garlic and grated ginger and saute for another minute.",
    "Add the trimmed runner beans and saute for 2-3 minutes.",
    "Pour in the chilled coconut cream and bring to a simmer.",
    "Add the salt and black pepper to taste.",
    "Add the bilo bilo and cook for an additional 5 minutes or until they float to the surface.",
    "Serve hot and enjoy."
  ],
