      "amount": "1 cup"
    },
    {
      "name": "garlic, minced",
      "amount": "3 cloves"
    },
    {
      "name": "diced tomatoes",
      "amount": "1 cup"
    },
    {
      "name": "ground cumin",
      "amount": "1 tsp"
