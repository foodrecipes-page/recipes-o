      "amount": "1 tsp"
    },
    {
      "name": "chopped scallions",
      "amount": "1/4 cup"
    },
    {
      "name": "chopped cilantro",
      "amount": "1/4 cup"
    },
    {
      "name": "fermented shrimp paste",
      "amount": "1 tsp"
    },
    {
      "name": "salt",
      "amount": "1/2 tsp"
    }
  ],
  "instructions": [
    "Bring a large pot of salted water to a boil and cook the rice noodles according to package instructions",
    "In a large bowl, whisk together fish sauce, lime juice, grated ginger, and fermented shrimp paste",
    "Add the cooked noodles to the bowl and toss to combine",
    "In a large skillet, heat 1 tablespoon of oil over medium-high heat and cook the shrimp until pink and cooked through",
    "Add the cooked shrimp to the bowl with the noodles and toss to combine",
    "Stir in chopped scallions and cilantro",
    "Season with salt to taste",
    "Serve immediately"
  ],
