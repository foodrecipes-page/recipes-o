{
  "title": "Oven-Roasted Jamaican Fish Bake",
  "description": "A yeasty, shaggy sick-day Jamaican fish dish with lime leaves and bright spices baked to perfection.",
  "cuisine": "Jamaican",
  "diet": [
    "pescatarian"
  ],
  "meal": "dinner",
  "ingredients": [
    {
      "name": "snapper",
      "amount": "2 whole",
      "notes": "cleaned, gutted"
    },
    {
      "name": "allspice",
      "amount": "2 tbsp",
      "notes": "Jamaican pimento"
    },
    {
      "name": "thyme",
      "amount": "1 tbsp",
      "notes": "fresh, chopped"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "sliced"
    },
    {
      "name": "lime",
      "amount": "1",
      "notes": "sliced into wedges"
    },
    {
      "name": "sea salt",
      "amount": "1 tsp"
    },
    {
      "name": "black pepper",
      "amount": "1/2 tsp"
    },
    {
      "name": "olive oil",
      "amount": "2 tbsp"
    },
    {
      "name": "lime juice",
      "amount": "2 tbsp"
    },
    {
      "name": "bell pepper",
      "amount": "1 cup",
      "notes": "sliced"
    },
    {
      "name": "carrot",
      "amount": "1 cup",
      "notes": "sliced"
    }
  ],
  "instructions": [
    "Preheat oven to 375°F (190°C).",
    "Pat the snapper dry with paper towels.",
    "In a small bowl mix allspice, thyme, minced garlic, salt, pepper, olive oil, and lime juice to form a paste.",
    "Rub the spice paste all over the fish, inside and out, then place inside a large baking dish.",
    "Arrange sliced onion, bell pepper, carrot, and lime wedges around the fish in the dish.",
    "Cover the dish tightly with foil to trap moisture and prevent over-drying.",
    "Bake for 25 minutes, then remove foil and continue baking for another 10 minutes until the fish flakes easily.",
    "Let the fish rest for 5 minutes before serving.",
    "Garnish with fresh thyme leaves if desired and serve hot."
  ],
