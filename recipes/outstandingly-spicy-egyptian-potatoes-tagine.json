      "name": "Jersey Royal potatoes",
      "amount": "4 large",
      "notes": "peeled and diced"
    },
    {
      "name": "shio-koji",
      "amount": "2 tablespoons",
      "notes": "mixed with 1 tablespoon water"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup"
    },
    {
      "name": "onion",
      "amount": "1 large",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "ginger",
      "amount": "1 inch",
      "notes": "grated"
    },
    {
      "name": "cumin",
      "amount": "1 teaspoon",
      "notes": "ground"
    },
    {
      "name": "coriander",
      "amount": "1 teaspoon",
      "notes": "ground"
    },
    {
      "name": "cayenne pepper",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon"
    }
  ],
  "instructions": [
    "Preheat the oven to 400 degrees Fahrenheit.",
    "Heat the olive oil in a large Dutch oven over medium heat.",
    "Add the chopped onion and cook until softened, about 5 minutes.",
    "Add the minced garlic and grated ginger and cook for 1 minute.",
    "Add the cumin, coriander, cayenne pepper, salt, and black pepper, and cook for 1 minute.",
    "Add the diced potatoes, shio-koji mixture, and 1 cup of water, and stir to combine.",
    "Bring the mixture to a boil, then cover the pot and transfer it to the preheated oven.",
    "Bake for 30 minutes, or until the potatoes are tender.",
    "Remove the pot from the oven and let it cool slightly.",
    "Serve the tagine hot, garnished with chopped fresh herbs if desired."
  ],
