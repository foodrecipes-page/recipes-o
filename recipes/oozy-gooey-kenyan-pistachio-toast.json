{
  "title": "Oozy Gooey Kenyan Pistachio Toast",
  "description": "A kid-friendly Kenyan dish featuring ground pistachios and toast, perfect for a sweet and tangy snack",
  "cuisine": "Kenyan",
  "diet": [
    "gluten-free"
  ],
  "meal": "snack",
  "ingredients": [
    {
      "name": "gluten-free bread",
      "amount": "4 slices",
      "notes": "white or whole grain"
    },
    {
      "name": "ground pistachios",
      "amount": "1/2 cup"
    },
    {
      "name": "honey",
      "amount": "2 tablespoons"
    },
    {
      "name": "lemon juice",
      "amount": "1 tablespoon"
    },
    {
      "name": "butter",
      "amount": "2 tablespoons"
    },
    {
      "name": "salt",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "vanilla extract",
      "amount": "1/4 teaspoon"
    }
  ],
  "instructions": [
    "Preheat the oven to 350 degrees Fahrenheit.",
    "Toast the bread slices until lightly browned.",
    "In a small bowl, mix together the ground pistachios, honey, lemon juice, and vanilla extract.",
    "Spread the pistachio mixture evenly onto the toasted bread slices.",
    "Dot the top of each slice with butter.",
    "Sprinkle a pinch of salt over the top of each slice.",
    "Place the slices on a baking sheet and bake for 5 minutes, or until the butter is melted and the pistachio mixture is gooey."
  ],
