      "name": "pitted dates",
      "amount": "1 cup",
      "notes": "soaked in water for 30 minutes"
    },
    {
      "name": "rice noodles",
      "amount": "8 oz",
      "notes": "cooked according to package instructions"
    },
    {
      "name": "lemon juice",
      "amount": "2 tbsp"
    },
    {
      "name": "lime juice",
      "amount": "1 tbsp"
    },
    {
      "name": "ginger",
      "amount": "1 inch",
      "notes": "grated"
    },
    {
      "name": "garlic",
      "amount": "2 cloves",
      "notes": "minced"
    },
    {
      "name": "pasta water",
      "amount": "1 cup"
    },
    {
      "name": "salt",
      "amount": "1 tsp"
    },
    {
      "name": "peanuts",
      "amount": "1/4 cup",
      "notes": "chopped"
    }
  ],
  "instructions": [
    "Cook the rice noodles according to package instructions and set aside.",
    "Soak the pitted dates in water for 30 minutes and then chop them into small pieces.",
    "Grate the ginger and mince the garlic.",
    "In a large bowl, whisk together the lemon juice, lime juice, grated ginger, and minced garlic.",
    "Add the cooked noodles, chopped dates, and pasta water to the bowl and toss to combine.",
    "Season with salt to taste.",
    "Garnish with chopped peanuts and serve immediately.",
    "Refrigerate any leftovers for up to 24 hours."
  ],
