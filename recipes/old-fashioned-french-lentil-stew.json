      "notes": "rinsed and drained"
    },
    {
      "name": "Elderflower syrup",
      "amount": "2 tablespoons"
    },
    {
      "name": "Ghee or vegetable oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "Onion",
      "amount": "1 medium",
      "notes": "chopped"
    },
    {
      "name": "Carrots",
      "amount": "2 medium",
      "notes": "peeled and chopped"
    },
    {
      "name": "Celery",
      "amount": "2 stalks",
      "notes": "chopped"
    },
    {
      "name": "Cumin seeds",
      "amount": "1 teaspoon"
    },
    {
      "name": "Coriander seeds",
      "amount": "1 teaspoon"
    },
    {
      "name": "Vegetable broth",
      "amount": "4 cups"
    },
    {
      "name": "Salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "Black pepper",
      "amount": "1/2 teaspoon"
    }
  ],
  "instructions": [
    "In a large pot, heat the ghee or oil over medium heat.",
    "Add the cumin seeds and coriander seeds and let them sizzle for a few seconds.",
    "Add the chopped onion, carrots, and celery and cook until the vegetables are tender.",
    "Add the French green lentils, vegetable broth, salt, and black pepper, and bring to a boil.",
    "Reduce the heat to low and simmer, covered, for 30 minutes, or until the lentils are tender.",
    "Stir in the elderflower syrup and continue to simmer for another 10 minutes.",
    "Serve the stew hot, garnished with fresh herbs if desired.",
    "Let the stew cool completely before refrigerating or freezing it."
  ],
