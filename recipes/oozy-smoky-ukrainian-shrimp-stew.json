  "ingredients": [
    {
      "name": "shrimp",
      "amount": "1 pound",
      "notes": "peeled and deveined"
    },
    {
      "name": "miso paste",
      "amount": "2 tablespoons"
    },
    {
      "name": "kapi paste",
      "amount": "1 tablespoon"
    },
    {
      "name": "smoked paprika",
      "amount": "1 teaspoon"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "chicken broth",
      "amount": "2 cups"
    },
    {
      "name": "tomato paste",
      "amount": "1 tablespoon"
    },
    {
      "name": "olive oil",
      "amount": "1 tablespoon"
    }
  ],
  "instructions": [
    "Heat the olive oil in a large pot over medium heat.",
    "Add the chopped onion and cook until softened, about 5 minutes.",
    "Add the minced garlic and cook for an additional minute.",
    "Add the shrimp and cook until pink, about 2-3 minutes per side.",
    "In a small bowl, whisk together the miso paste, kapi paste, and smoked paprika.",
    "Add the paste mixture to the pot and stir to combine.",
    "Add the chicken broth and tomato paste to the pot and bring to a boil.",
    "Reduce the heat to low and simmer, covered, for 10 minutes.",
    "Season with salt and pepper to taste.",
    "Serve hot, garnished with chopped fresh herbs if desired."
  ],
