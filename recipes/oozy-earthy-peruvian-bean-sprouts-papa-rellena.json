  "ingredients": [
    {
      "name": "mashed potatoes",
      "amount": "2 cups",
      "notes": "cooked and cooled"
    },
    {
      "name": "bean sprouts",
      "amount": "1 cup",
      "notes": "fresh"
    },
    {
      "name": "onion",
      "amount": "1/2 cup",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "2 cloves",
      "notes": "minced"
    },
    {
      "name": "turmeric",
      "amount": "1 teaspoon",
      "notes": "ground"
    },
    {
      "name": "paprika",
      "amount": "1/2 teaspoon",
      "notes": "smoked"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon",
      "notes": "to taste"
    },
    {
      "name": "olive oil",
      "amount": "2 tablespoons",
      "notes": "for frying"
    }
  ],
  "instructions": [
    "Preheat the oven to 375 degrees.",
    "In a large bowl, combine the mashed potatoes, bean sprouts, onion, garlic, turmeric, paprika, and salt.",
    "Mix well until all the ingredients are fully incorporated.",
    "Divide the mixture into 4 equal parts and shape each part into a ball.",
    "Flatten each ball into a disk shape.",
    "Heat the olive oil in a large skillet over medium heat.",
    "Fry the disks until they are golden brown and crispy.",
    "Transfer the fried disks to a baking sheet and bake for 15 minutes.",
    "Serve the papa rellena hot and enjoy."
  ],
