    },
    {
      "name": "lemon juice",
      "amount": "2 tbsp"
    },
    {
      "name": "soy sauce",
      "amount": "1 tbsp"
    },
    {
      "name": "sesame oil free seasoning",
      "amount": "1 tsp"
    },
    {
      "name": "salt",
      "amount": "1/2 tsp"
    },
    {
      "name": "water",
      "amount": "2 cups"
    }
  ],
  "instructions": [
    "Bring the water to a boil in a large pot.",
    "Add the sliced ginger and cook for 5 minutes.",
    "Add the rice noodles and cook for 3 minutes or until they are slightly tender.",
    "Add the petit pois and cook for an additional 2 minutes.",
    "In a small bowl, whisk together the lemon juice, soy sauce, and sesame oil free seasoning.",
    "Pour the seasoning mixture over the noodles and petit pois.",
    "Add the minced garlic and salt, and stir to combine.",
    "Serve the noodles hot, garnished with additional ginger slices if desired."
