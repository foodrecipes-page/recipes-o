{
  "title": "Oil Infused Middle Eastern Red Peppers Muhammara",
  "description": "A citrusy and crumbly Middle Eastern dish featuring roasted red peppers, perfect for a crowd, and made with dark soy sauce and lacquer glaze, this recipe is FODMAP friendly.",
  "cuisine": "Middle Eastern",
  "diet": [
    "vegetarian"
  ],
