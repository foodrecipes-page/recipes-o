      "name": "red peppers",
      "amount": "4 large",
      "notes": "any color"
    },
    {
      "name": "dark soy sauce",
      "amount": "2 tablespoons"
    },
    {
      "name": "lacquer glaze",
      "amount": "1 tablespoon"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup"
    },
    {
      "name": "garlic-infused oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "lemon juice",
      "amount": "2 tablespoons"
    },
    {
      "name": "pomegranate molasses",
      "amount": "1 tablespoon"
    },
    {
      "name": "walnuts",
      "amount": "1/2 cup",
      "notes": "chopped"
    }
  ],
  "instructions": [
    "Preheat the oven to 425 degrees Fahrenheit.",
    "Place the red peppers on a baking sheet and roast for 30 minutes.",
    "Remove the peppers from the oven and let them cool.",
    "Peel the peppers and place them in a food processor.",
    "Add the dark soy sauce, lacquer glaze, olive oil, garlic-infused oil, lemon juice, and pomegranate molasses to the food processor.",
    "Process the mixture until it is smooth.",
    "Stir in the chopped walnuts.",
    "Transfer the muhammara to a serving bowl.",
    "Serve the muhammara at room temperature.",
    "Garnish with additional walnuts if desired."
  ],
