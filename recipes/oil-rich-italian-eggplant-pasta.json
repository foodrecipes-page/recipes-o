      "name": "eggplant",
      "amount": "2 medium",
      "notes": "chopped into 1 inch cubes"
    },
    {
      "name": "pasta",
      "amount": "8 oz",
      "notes": "penne or rigatoni"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup"
    },
    {
      "name": "sesame seeds",
      "amount": "2 tbsp"
    },
    {
      "name": "coriander seeds",
      "amount": "1 tsp"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "tomato sauce",
      "amount": "1 cup"
    },
    {
      "name": "red pepper flakes",
      "amount": "1/4 tsp"
    },
    {
      "name": "salt",
      "amount": "1/2 tsp"
    },
    {
      "name": "black pepper",
      "amount": "1/4 tsp"
    }
  ],
  "instructions": [
    "Heat the olive oil in a large skillet over medium heat.",
    "Add the sesame seeds and coriander seeds and let them sizzle for 1 minute.",
    "Add the chopped eggplant and cook until it is tender and lightly browned.",
    "Add the minced garlic and cook for 1 minute.",
    "Add the tomato sauce, red pepper flakes, salt, and black pepper, and stir to combine.",
    "Bring the sauce to a simmer and let it cook for 10 minutes.",
    "While the sauce is cooking, cook the pasta according to the package instructions.",
    "Drain the pasta and add it to the skillet with the sauce.",
    "Toss the pasta in the sauce to combine and serve hot."
  ],
