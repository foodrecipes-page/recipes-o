  "ingredients": [
    {
      "name": "lemons",
      "amount": "12",
      "notes": "cut into 1 inch pieces"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup"
    },
    {
      "name": "honey",
      "amount": "2 tablespoons"
    },
    {
      "name": "garlic powder",
      "amount": "1 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "fresh parsley",
      "amount": "1/4 cup",
      "notes": "chopped"
    }
  ],
  "instructions": [
    "Preheat the oven to 400 degrees.",
    "Thread lemon pieces onto skewers, leaving a small space between each piece.",
    "In a small bowl, whisk together olive oil, honey, garlic powder, salt, and black pepper.",
    "Brush the mixture onto both sides of the lemon pieces.",
    "Place the skewers on a baking sheet lined with parchment paper.",
    "Roast in the preheated oven for 15 minutes, or until the lemons are caramelized.",
    "Remove from the oven and sprinkle with chopped parsley.",
    "Serve warm and enjoy."
  ],
