      "amount": "1/4 cup"
    },
    {
      "name": "claypot",
      "amount": "1",
      "notes": "for serving"
    },
    {
      "name": "yogurt",
      "amount": "1/2 cup",
      "notes": "for serving"
    }
  ],
  "instructions": [
    "Preheat the air fryer to 375 degrees Fahrenheit.",
    "In a large bowl, combine the cooked kidney beans, chopped onion, minced garlic, tomato paste, paprika, black pepper, and salt, and mix well.",
    "Spoon the kidney bean mixture into the claypot, leaving about 1 inch of space at the top.",
    "Drizzle the vegetable oil over the top of the kidney bean mixture.",
    "Place the claypot in the air fryer basket and cook for 20 minutes.",
    "Remove the claypot from the air fryer and let it cool for a few minutes.",
    "Serve the dolma hot, topped with a dollop of yogurt.",
    "Garnish with chopped fresh parsley or dill, if desired."
  ],
