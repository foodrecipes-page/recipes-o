      "amount": "8 ounces",
      "notes": "at least 70% cocoa"
    },
    {
      "name": "heavy cream",
      "amount": "1 cup"
    },
    {
      "name": "unsalted butter",
      "amount": "1/2 cup"
    },
    {
      "name": "vanilla extract",
      "amount": "1 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "stone bowl",
      "amount": "1",
      "notes": "dolsot style"
    }
  ],
  "instructions": [
    "Melt the chocolate in a double boiler over low heat.",
    "In a separate bowl, whip the heavy cream until it forms stiff peaks.",
    "Add the unsalted butter, vanilla extract, and salt to the whipped cream and mix until combined.",
    "Fold the melted chocolate into the cream mixture until well combined.",
    "Pour the mixture into the stone bowl.",
    "Refrigerate the mixture for at least 2 hours to set.",
    "Serve the chocolate bowl chilled, garnished with additional whipped cream if desired."
