{
  "title": "Oven Roasted Uruguayan Beef Skewers",
  "description": "A delicious and flavorful Uruguayan dish featuring beef skewers with a jerk seasoning and a beurre monte sauce, perfect for a date night",
  "cuisine": "Uruguayan",
  "diet": [
