  "ingredients": [
    {
      "name": "prawns",
      "amount": "1 pound",
      "notes": "peeled and deveined"
    },
    {
      "name": "lemon juice",
      "amount": "1/4 cup"
    },
    {
      "name": "pickle relish",
      "amount": "2 tablespoons"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "ginger",
      "amount": "1 tablespoon",
      "notes": "grated"
    },
    {
      "name": "olive oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "fresh parsley",
      "amount": "1/4 cup",
      "notes": "chopped"
    }
  ],
  "instructions": [
    "Preheat the grill to medium-high heat",
    "In a large bowl, whisk together lemon juice, pickle relish, garlic, and ginger",
    "Add the prawns to the bowl and toss to coat with the marinade",
    "Thread the marinated prawns onto skewers, leaving a small space between each prawn",
    "Brush the skewers with olive oil and season with salt and black pepper",
    "Grill the skewers for 8-10 minutes, turning occasionally, until the prawns are pink and cooked through",
    "Serve the skewers hot, garnished with chopped fresh parsley"
  ],
