    {
      "name": "boneless chicken breast",
      "amount": "1 pound",
      "notes": "cut into bite sized pieces"
    },
    {
      "name": "mixed greens",
      "amount": "4 cups"
    },
    {
      "name": "cherry tomatoes",
      "amount": "1 cup",
      "notes": "halved"
    },
    {
      "name": "cucumber",
      "amount": "1",
      "notes": "sliced"
    },
    {
      "name": "red onion",
      "amount": "1/2",
      "notes": "thinly sliced"
    },
    {
      "name": "apple cider vinegar",
      "amount": "2 tablespoons"
    },
    {
      "name": "lemon juice",
      "amount": "1 tablespoon"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "turmeric",
      "amount": "1/4 teaspoon"
    }
  ],
  "instructions": [
    "Preheat a grill or grill pan to medium high heat.",
    "Season the chicken with salt, black pepper, and turmeric.",
    "Grill the chicken for 5-6 minutes per side, or until it reaches an internal temperature of 165 degrees.",
    "Let the chicken rest for a few minutes before chopping it into bite sized pieces.",
    "In a large bowl, combine the mixed greens, cherry tomatoes, cucumber, and red onion.",
    "In a small bowl, whisk together the apple cider vinegar and lemon juice.",
    "Pour the vinaigrette dressing over the salad and toss to combine.",
    "Add the grilled chicken to the salad and toss again to combine.",
    "Serve immediately and enjoy."
  ],
