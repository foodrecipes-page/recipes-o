{
  "title": "Portuguese Fish Stew",
  "description": "A hearty and comforting fish stew featuring dry sherry and a variety of seafood, perfect for a chilly evening",
  "cuisine": "Portuguese",
  "diet": [
    "pescatarian"
  ],
