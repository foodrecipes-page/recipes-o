      "amount": "1 tsp"
    },
    {
      "name": "grated parmesan cheese",
      "amount": "1/4 cup"
    }
  ],
  "instructions": [
    "Preheat the oven to 400 degrees.",
    "Place the eggplant cubes on a baking sheet lined with parchment paper and roast for 30 minutes.",
    "In a large skillet, heat the olive oil over medium heat and saute the onion, carrot, and celery until tender.",
    "Add the tomato paste to the skillet and cook for 1 minute.",
    "Add the canned tomatoes, red wine vinegar, salt, and black pepper to the skillet and stir to combine.",
    "Add the roasted eggplant to the skillet and stir to combine.",
    "Transfer the ragu to a ramekin and top with grated parmesan cheese.",
    "Place the ramekin in the oven and bake for 15 minutes."
  ],
