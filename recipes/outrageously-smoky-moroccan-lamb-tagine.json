      "name": "lamb shoulder",
      "amount": "2 pounds",
      "notes": "boneless, cut into 2-inch pieces"
    },
    {
      "name": "dark rum",
      "amount": "1/4 cup"
    },
    {
      "name": "olive oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "smoked paprika",
      "amount": "2 teaspoons"
    },
    {
      "name": "ground cumin",
      "amount": "1 teaspoon"
    },
    {
      "name": "ground coriander",
      "amount": "1 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "dried apricots",
      "amount": "1 cup",
      "notes": "chopped"
    },
    {
      "name": "prunes",
      "amount": "1 cup",
      "notes": "pitted"
    }
  ],
  "instructions": [
    "Preheat the oven to 300 degrees Fahrenheit.",
    "In a large Dutch oven, heat the olive oil over medium heat.",
    "Add the lamb pieces and cook until browned on all sides, about 5 minutes.",
    "Add the smoked paprika, cumin, coriander, salt, and pepper, and cook for 1 minute.",
    "Add the dark rum, dried apricots, and prunes, and stir to combine.",
    "Cover the Dutch oven and transfer it to the preheated oven.",
    "Braise the lamb for 2 1/2 hours, or until tender and falling apart.",
    "Remove the Dutch oven from the oven and let it cool slightly.",
    "Serve the lamb tagine hot, garnished with fresh parsley or cilantro."
  ],
