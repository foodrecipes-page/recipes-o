    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "low-sodium chicken broth",
      "amount": "4 cups"
    },
    {
      "name": "tomato paste",
      "amount": "2 tablespoons"
    }
  ],
  "instructions": [
    "Heat oil in a large pot over medium heat.",
    "Add the chopped onion and cook until softened, about 5 minutes.",
    "Add the minced garlic and grated ginger and cook for an additional 1 minute.",
    "Add the rest-meat and cook until browned, about 5 minutes.",
    "Add the chopped Chinese cabbage, berbere spice, and black pepper, and cook until the cabbage is wilted.",
    "Add the low-sodium chicken broth and tomato paste, and stir to combine.",
    "Bring the stew to a boil, then reduce the heat to low and simmer, covered, for 20 minutes.",
    "Season with salt to taste, then serve hot."
  ],
